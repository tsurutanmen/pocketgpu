#version 450
// out[i] = storage image の (x, y) の赤 + サンプラーつきの画像の (x, y) の赤（i = y * 16 + x）
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, rgba32f) readonly uniform image2D simg;
layout(std430, set = 0, binding = 1) writeonly buffer O { float o[]; };
layout(set = 0, binding = 2) uniform sampler2D timg;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    o[p.y * 16 + p.x] = imageLoad(simg, p).r + texelFetch(timg, p, 0).r;
}
