<!-- カメラ：iPhone のカメラを PC のカメラとして使う（webcam_rx・仮想カメラ） -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 見出しの横に iPhone の温度（信号の 3 色・危険は点滅。度数は電池の温度。PageCamCtl.cs の PaintThermal） -->
  <DockPanel Margin="0,0,0,14">
    <StackPanel x:Name="CamThermal" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
      <TextBlock Text="{DynamicResource s_ctl_temp}" Foreground="{DynamicResource Sub}" VerticalAlignment="Center"/>
      <Ellipse x:Name="CamThermalDot" Width="9" Height="9" Margin="12,1,7,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="CamThermalText" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock Style="{StaticResource H1}" Margin="0" Text="{DynamicResource s_nav_camera}"/>
  </DockPanel>

  <Border Style="{StaticResource Card}" Padding="12">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="336"/>
        <ColumnDefinition Width="24"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Width="336" Height="189" CornerRadius="4" Background="{DynamicResource PreviewBg}" ClipToBounds="True">
        <Grid>
          <Image x:Name="CamImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock x:Name="CamPreviewNote" Foreground="{DynamicResource PreviewText}" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="24,0"/>
          <TextBlock x:Name="CamPreviewLabel" Text="{DynamicResource s_cam_preview}" Foreground="{DynamicResource PreviewLabel}" FontSize="12" Margin="10,0,0,9" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
        </Grid>
      </Border>
      <DockPanel Grid.Column="2" Margin="0,6,0,0">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
          <Button x:Name="CamPreviewBtn" Style="{StaticResource Btn}" Margin="0,0,8,0"/>
          <Button x:Name="CamStartBtn" Style="{StaticResource Btn}"/>
        </StackPanel>
        <StackPanel>
          <TextBlock x:Name="CamState" Style="{StaticResource HeroTitle}"/>
          <TextBlock x:Name="CamDetail" Style="{StaticResource HeroText}"/>
        </StackPanel>
      </DockPanel>
    </Grid>
  </Border>

  <!-- 熱の知らせ：熱でフレームレートを下げている・危険（iPhone の画面を暗くするボタンは操作の 29 があるときだけ） -->
  <Border x:Name="CamHeatCard" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="Collapsed">
    <Border Style="{StaticResource Row}">
      <DockPanel>
        <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_thermo}"/>
        <Button x:Name="CamDimBtn" Style="{StaticResource BtnRow}" Content="{DynamicResource s_ctl_dim_btn}"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="CamHeatTitle" Style="{StaticResource RowTitle}"/>
          <TextBlock x:Name="CamHeatSub" Style="{StaticResource RowSub}"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Border>

  <!-- 配信しながら操作する用：スピーカー・マイク・字幕。ホームと各画面のスイッチと同じ状態を見せる（PageCamera.cs の CamQuick） -->
  <TextBlock Style="{StaticResource Sec}" Text="{DynamicResource s_cam_quick}"/>
  <Border Style="{StaticResource Card}">
    <StackPanel>
      <Border Style="{StaticResource Row}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_speaker}"/>
          <CheckBox x:Name="CamSpkSw" Style="{StaticResource Switch}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_audio_spk}"/>
            <TextBlock x:Name="CamSpkSub" Style="{StaticResource RowSub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_mic}"/>
          <CheckBox x:Name="CamMicSw" Style="{StaticResource Switch}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_audio_mic}"/>
            <TextBlock x:Name="CamMicSub" Style="{StaticResource RowSub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_caption}"/>
          <CheckBox x:Name="CamCapSw" Style="{StaticResource Switch}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_nav_caption}"/>
            <TextBlock x:Name="CamCapSub" Style="{StaticResource RowSub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
  </Border>

  <TextBlock Style="{StaticResource Sec}" Text="{DynamicResource s_cam_video}"/>
  <Border Style="{StaticResource Card}">
    <StackPanel>
      <Border Style="{StaticResource Row}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_camera}"/>
          <ComboBox x:Name="CamWhich" Style="{StaticResource Select}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_cam_which}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_cam_which_sub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_res}"/>
          <Border Style="{StaticResource SegBox}">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="CamRes720" GroupName="camres" Style="{StaticResource SegItem}" Content="720p"/>
              <RadioButton x:Name="CamRes1080" GroupName="camres" Style="{StaticResource SegItem}" Content="1080p"/>
              <RadioButton x:Name="CamRes2160" GroupName="camres" Style="{StaticResource SegItem}" Content="{DynamicResource s_cam_res_4k}"/>
            </StackPanel>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_cam_res}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_fps}"/>
          <Border Style="{StaticResource SegBox}">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="CamFps30" GroupName="camfps" Style="{StaticResource SegItem}" Content="30 fps"/>
              <RadioButton x:Name="CamFps60" GroupName="camfps" Style="{StaticResource SegItem}" Content="60 fps"/>
            </StackPanel>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_cam_fps}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_cam_fps_sub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_gpu}"/>
          <Border Style="{StaticResource SegBox}">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="CamDecGpu" GroupName="camdec" Style="{StaticResource SegItem}" Content="GPU"/>
              <RadioButton x:Name="CamDecCpu" GroupName="camdec" Style="{StaticResource SegItem}" Content="CPU"/>
            </StackPanel>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_cam_decode}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_image}"/>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="CamQualityText" Foreground="{DynamicResource Sub}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Slider x:Name="CamQuality" Style="{StaticResource Slider}" Minimum="0" Maximum="3"/>
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_cam_quality}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_cam_quality_sub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
  </Border>

  <!-- PC からの操作（camctl）。届いた caps の項目だけを、iPhone のアプリと同じまとまりと順で、コードで並べる（PageCamCtl.cs） -->
  <StackPanel x:Name="CamCtlNoteBox" Visibility="Collapsed">
    <TextBlock Style="{StaticResource Sec}" Text="{DynamicResource s_ctl_sec}"/>
    <Border Style="{StaticResource Card}">
      <Border Style="{StaticResource Row}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_info}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="CamCtlNote" Style="{StaticResource RowTitle}"/>
            <TextBlock x:Name="CamCtlErr" Style="{StaticResource RowSub}" Visibility="Collapsed"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </Border>
  </StackPanel>
  <StackPanel x:Name="CamCtlHost"/>

  <TextBlock Style="{StaticResource Sec}" Text="{DynamicResource s_cam_conn}"/>
  <Border Style="{StaticResource Card}">
    <StackPanel>
      <Border Style="{StaticResource Row}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_vcam}"/>
          <Button x:Name="CamVcamBtn" Style="{StaticResource BtnRow}"/>
          <TextBlock x:Name="CamVcamState" Style="{StaticResource Val}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_cam_vcam}"/>
            <TextBlock x:Name="CamVcamSub" Style="{StaticResource RowSub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_wifi}"/>
          <CheckBox x:Name="CamWifi" Style="{StaticResource Switch}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_cam_wifi}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_cam_wifi_sub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border x:Name="CamWifiAddrRow" Style="{StaticResource RowNext}" Padding="56,9,20,9">
        <DockPanel>
          <TextBox x:Name="CamWifiAddr" Style="{StaticResource Field}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_cam_wifi_addr}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_cam_wifi_addr_sub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border x:Name="CamWifiCodeRow" Style="{StaticResource RowNext}" Padding="56,9,20,9">
        <DockPanel>
          <TextBox x:Name="CamWifiCode" Style="{StaticResource Field}" FontFamily="{StaticResource MonoFont}" MaxLength="7"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_cam_wifi_code}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_cam_wifi_code_sub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
  </Border>
</StackPanel>
