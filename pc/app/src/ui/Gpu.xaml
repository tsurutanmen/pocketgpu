<!-- GPU：ゲームやアプリを iPhone の GPU で起動する（Run-on-iPhone-GPU と同じ手順） -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <TextBlock Style="{StaticResource H1}" Text="{DynamicResource s_nav_gpu}"/>

  <Border Style="{StaticResource Card}" Padding="20,16">
    <DockPanel>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
        <Button x:Name="GpuLaunch" Style="{StaticResource BtnPrimary}" Content="{DynamicResource s_gpu_launch}" Margin="0,0,8,0"/>
        <Button x:Name="GpuGoCheck" Style="{StaticResource Btn}" Content="{DynamicResource s_home_check}"/>
      </StackPanel>
      <StackPanel>
        <TextBlock x:Name="GpuState" Style="{StaticResource HeroTitle}"/>
        <TextBlock x:Name="GpuDetail" Style="{StaticResource HeroText}"/>
      </StackPanel>
    </DockPanel>
  </Border>

  <TextBlock Style="{StaticResource Sec}" Text="{DynamicResource s_gpu_running}"/>
  <Border Style="{StaticResource Card}">
    <StackPanel x:Name="GpuRunningRows"/>
  </Border>

  <TextBlock Style="{StaticResource Sec}" Text="{DynamicResource s_gpu_recent}"/>
  <Border Style="{StaticResource Card}">
    <StackPanel x:Name="GpuRecentRows"/>
  </Border>

  <TextBlock Style="{StaticResource Sec}" Text="{DynamicResource s_gpu_more}"/>
  <Border Style="{StaticResource Card}">
    <StackPanel>
      <Border Style="{StaticResource Row}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_copy}"/>
          <Button x:Name="GpuSteamCopy" Style="{StaticResource BtnRow}" Content="{DynamicResource s_copy}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_gpu_steam}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_gpu_steam_sub}"/>
            <TextBlock x:Name="GpuSteamLine" Style="{StaticResource RowSub}" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_thermo}"/>
          <Button x:Name="GpuStatusBtn" Style="{StaticResource BtnRow}" Content="{DynamicResource s_refresh}"/>
          <TextBlock x:Name="GpuStatusVal" Style="{StaticResource Val}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_gpu_heat}"/>
            <TextBlock x:Name="GpuStatusSub" Style="{StaticResource RowSub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_fps}"/>
          <CheckBox x:Name="GpuDiag" Style="{StaticResource Switch}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_gpu_diag}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_gpu_diag_sub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
  </Border>
</StackPanel>
