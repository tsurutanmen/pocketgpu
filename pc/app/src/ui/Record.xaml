<!-- 録画：iPhone の GPU で描いているゲームを iPhone が録画する（ドライバの IPHONE_VK_RECORD_*） -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <TextBlock Style="{StaticResource H1}" Text="{DynamicResource s_nav_record}"/>

  <Border Style="{StaticResource Card}" Padding="20,16">
    <DockPanel>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
        <Button x:Name="RecStartBtn" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"/>
        <Button x:Name="RecOpenBtn" Style="{StaticResource Btn}" Content="{DynamicResource s_rec_open}"/>
      </StackPanel>
      <StackPanel>
        <TextBlock x:Name="RecState" Style="{StaticResource HeroTitle}"/>
        <TextBlock x:Name="RecDetail" Style="{StaticResource HeroText}"/>
      </StackPanel>
    </DockPanel>
  </Border>

  <TextBlock Style="{StaticResource Sec}" Text="{DynamicResource s_rec_settings}"/>
  <Border Style="{StaticResource Card}">
    <StackPanel>
      <Border Style="{StaticResource Row}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_file}"/>
          <Border Style="{StaticResource SegBox}">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="RecHevc" GroupName="rcodec" Style="{StaticResource SegItem}" Content="HEVC"/>
              <RadioButton x:Name="RecH264" GroupName="rcodec" Style="{StaticResource SegItem}" Content="H.264"/>
            </StackPanel>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_rec_codec}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_rec_codec_sub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_speaker}"/>
          <CheckBox x:Name="RecAudio" Style="{StaticResource Switch}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_rec_audio}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_rec_audio_sub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_pc}"/>
          <CheckBox x:Name="RecFetch" Style="{StaticResource Switch}"/>
          <Button x:Name="RecFolderBtn" Style="{StaticResource BtnRow}" Margin="16,0,0,0" Content="{DynamicResource s_change}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_rec_fetch}"/>
            <TextBlock x:Name="RecFolderSub" Style="{StaticResource RowSub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_phone}"/>
          <CheckBox x:Name="RecKeep" Style="{StaticResource Switch}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_rec_keep}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_rec_keep_sub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_image}"/>
          <CheckBox x:Name="RecPhotos" Style="{StaticResource Switch}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_rec_photos}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_rec_photos_sub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
  </Border>
</StackPanel>
