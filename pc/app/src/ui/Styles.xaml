<!-- PocketGPU の見た目の部品。案 A（Windows 11 の設定アプリ型）の形。アプリの Resources に入れる。
     形（スタイル・アイコン・字体）は StaticResource で引ける。色はここに置かず、ThemeLight.xaml と ThemeDark.xaml にある。
     色は必ず {DynamicResource 名前} で引く（ライトとダークをその場で差し替えるため。StaticResource で引くと読み込みで止まる）。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Yu Gothic UI</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Yu Gothic UI</FontFamily>

  <!-- ===== 線のアイコン（24 の枠で描いて、Viewbox で縮める。線の太さは 1.5） ===== -->
  <GeometryGroup x:Key="i_home"><PathGeometry Figures="M4,10.5 L12,4 L20,10.5 V20 A1,1 0 0 1 19,21 H14.5 V15 H9.5 V21 H5 A1,1 0 0 1 4,20 Z"/></GeometryGroup>
  <GeometryGroup x:Key="i_gpu">
    <RectangleGeometry Rect="6,6,12,12" RadiusX="2" RadiusY="2"/>
    <RectangleGeometry Rect="9.5,9.5,5,5" RadiusX="1" RadiusY="1"/>
    <PathGeometry Figures="M9,3 V6 M12,3 V6 M15,3 V6 M9,18 V21 M12,18 V21 M15,18 V21 M3,9 H6 M3,12 H6 M3,15 H6 M18,9 H21 M18,12 H21 M18,15 H21"/>
  </GeometryGroup>
  <GeometryGroup x:Key="i_camera">
    <PathGeometry Figures="M4,8 A2,2 0 0 1 6,6 H8 L9.5,4 H14.5 L16,6 H18 A2,2 0 0 1 20,8 V17 A2,2 0 0 1 18,19 H6 A2,2 0 0 1 4,17 Z"/>
    <EllipseGeometry Center="12,12.5" RadiusX="3.5" RadiusY="3.5"/>
  </GeometryGroup>
  <GeometryGroup x:Key="i_mic">
    <RectangleGeometry Rect="9,3,6,11" RadiusX="3" RadiusY="3"/>
    <PathGeometry Figures="M5.5,11 A6.5,6.5 0 0 0 18.5,11 M12,17.5 V21 M9,21 H15"/>
  </GeometryGroup>
  <GeometryGroup x:Key="i_caption">
    <RectangleGeometry Rect="3,5,18,14" RadiusX="2" RadiusY="2"/>
