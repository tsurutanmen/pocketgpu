  </GeometryGroup>
  <GeometryGroup x:Key="i_rec"><EllipseGeometry Center="12,12" RadiusX="8.5" RadiusY="8.5"/></GeometryGroup>
  <EllipseGeometry x:Key="i_rec_fill" Center="12,12" RadiusX="3.5" RadiusY="3.5"/>
  <GeometryGroup x:Key="i_check">
    <EllipseGeometry Center="12,12" RadiusX="8.5" RadiusY="8.5"/>
    <PathGeometry Figures="M8.5,12.2 L10.9,14.6 L15.5,9.8"/>
  </GeometryGroup>
  <GeometryGroup x:Key="i_warn">
    <EllipseGeometry Center="12,12" RadiusX="8.5" RadiusY="8.5"/>
    <PathGeometry Figures="M12,7.8 V12.8"/>
    <EllipseGeometry Center="12,16.2" RadiusX="0.5" RadiusY="0.5"/>
  </GeometryGroup>
  <GeometryGroup x:Key="i_circle"><EllipseGeometry Center="12,12" RadiusX="8.5" RadiusY="8.5"/></GeometryGroup>
  <GeometryGroup x:Key="i_phone">
    <RectangleGeometry Rect="6.5,2.5,11,19" RadiusX="2.5" RadiusY="2.5"/>
    <PathGeometry Figures="M10.5,5 H13.5"/>
  </GeometryGroup>
  <GeometryGroup x:Key="i_res"><PathGeometry Figures="M4,9 V5 H8 M16,5 H20 V9 M20,15 V19 H16 M8,19 H4 V15"/></GeometryGroup>
  <GeometryGroup x:Key="i_fps">
    <EllipseGeometry Center="12,13.5" RadiusX="7.5" RadiusY="7.5"/>
    <PathGeometry Figures="M12,13.5 V9.5 M10,3 H14"/>
  </GeometryGroup>
  <GeometryGroup x:Key="i_image">
    <RectangleGeometry Rect="3.5,5,17,14" RadiusX="2" RadiusY="2"/>
    <PathGeometry Figures="M3.5,16 L8,11.5 L12,15.5 L15,12.5 L20.5,18"/>
    <EllipseGeometry Center="15.5,9.5" RadiusX="1.5" RadiusY="1.5"/>
  </GeometryGroup>
  <GeometryGroup x:Key="i_vcam">
    <RectangleGeometry Rect="3,6.5,12.5,11" RadiusX="2" RadiusY="2"/>
    <PathGeometry Figures="M15.5,10.5 L20.5,7.5 V16.5 L15.5,13.5 Z"/>
  </GeometryGroup>
  <GeometryGroup x:Key="i_wifi">
    <PathGeometry Figures="M2.5,9 A14,14 0 0 1 21.5,9 M5.5,12.3 A9.5,9.5 0 0 1 18.5,12.3 M8.6,15.5 A5,5 0 0 1 15.4,15.5"/>
    <EllipseGeometry Center="12,18.6" RadiusX="0.6" RadiusY="0.6"/>
  </GeometryGroup>
  <GeometryGroup x:Key="i_app">
    <RectangleGeometry Rect="4,4,16,16" RadiusX="3.5" RadiusY="3.5"/>
    <RectangleGeometry Rect="8.5,8.5,7,7" RadiusX="1.2" RadiusY="1.2"/>
  </GeometryGroup>
  <GeometryGroup x:Key="i_settings">
    <PathGeometry Figures="M4,7 H13.5 M18.5,7 H20 M4,17 H5.5 M10.5,17 H20"/>
    <EllipseGeometry Center="16,7" RadiusX="2.5" RadiusY="2.5"/>
    <EllipseGeometry Center="8,17" RadiusX="2.5" RadiusY="2.5"/>
  </GeometryGroup>
  <GeometryGroup x:Key="i_speaker"><PathGeometry Figures="M4,9.5 H7.5 L12,6 V18 L7.5,14.5 H4 Z M15.5,9.5 A3.5,3.5 0 0 1 15.5,14.5 M17.8,7.2 A6.5,6.5 0 0 1 17.8,16.8"/></GeometryGroup>
  <GeometryGroup x:Key="i_folder"><PathGeometry Figures="M3.5,7 A1.5,1.5 0 0 1 5,5.5 H9.5 L11.5,7.5 H19 A1.5,1.5 0 0 1 20.5,9 V17 A1.5,1.5 0 0 1 19,18.5 H5 A1.5,1.5 0 0 1 3.5,17 Z"/></GeometryGroup>
  <GeometryGroup x:Key="i_play">
    <RectangleGeometry Rect="3.5,4.5,17,15" RadiusX="2" RadiusY="2"/>
    <PathGeometry Figures="M10,9 L15,12 L10,15 Z"/>
  </GeometryGroup>
  <GeometryGroup x:Key="i_copy">
    <RectangleGeometry Rect="8,8,12,12" RadiusX="2" RadiusY="2"/>
    <PathGeometry Figures="M16,8 V6 A2,2 0 0 0 14,4 H6 A2,2 0 0 0 4,6 V14 A2,2 0 0 0 6,16 H8"/>
  </GeometryGroup>
  <GeometryGroup x:Key="i_globe">
    <EllipseGeometry Center="12,12" RadiusX="8.5" RadiusY="8.5"/>
    <PathGeometry Figures="M3.5,12 H20.5 M12,3.5 C9.3,6.5 9.3,17.5 12,20.5 M12,3.5 C14.7,6.5 14.7,17.5 12,20.5"/>
  </GeometryGroup>
  <GeometryGroup x:Key="i_info">
    <EllipseGeometry Center="12,12" RadiusX="8.5" RadiusY="8.5"/>
    <PathGeometry Figures="M12,11 V16.2"/>
    <EllipseGeometry Center="12,7.8" RadiusX="0.5" RadiusY="0.5"/>
  </GeometryGroup>
  <GeometryGroup x:Key="i_thermo"><PathGeometry Figures="M10,13.8 V5.5 A2,2 0 0 1 14,5.5 V13.8 A4,4 0 1 1 10,13.8 Z M12,10 V16"/></GeometryGroup>
  <GeometryGroup x:Key="i_window">
    <RectangleGeometry Rect="3.5,5,17,14" RadiusX="2" RadiusY="2"/>
    <PathGeometry Figures="M3.5,9 H20.5"/>
  </GeometryGroup>
  <GeometryGroup x:Key="i_file"><PathGeometry Figures="M6.5,3.5 H13.5 L18.5,8.5 V19 A1.5,1.5 0 0 1 17,20.5 H6.5 A1.5,1.5 0 0 1 5,19 V5 A1.5,1.5 0 0 1 6.5,3.5 Z M13.5,3.5 V8.5 H18.5"/></GeometryGroup>
  <GeometryGroup x:Key="i_translate"><PathGeometry Figures="M4,6 H12 M8,4 V6 M10.5,6 C10,9.5 7.5,12.5 4.5,14 M6.5,9 C7.5,11 9.5,12.8 12,13.5 M12.5,20 L16,11.5 L19.5,20 M13.7,17.2 H18.3"/></GeometryGroup>
  <GeometryGroup x:Key="i_pc"><PathGeometry Figures="M4,5.5 H20 A1,1 0 0 1 21,6.5 V15.5 A1,1 0 0 1 20,16.5 H4 A1,1 0 0 1 3,15.5 V6.5 A1,1 0 0 1 4,5.5 Z M9,20 H15 M12,16.5 V20"/></GeometryGroup>
  <GeometryGroup x:Key="i_usb"><PathGeometry Figures="M12,3.5 V17 M9.5,6 L12,3.5 L14.5,6 M12,14 L7.5,11.5 V9 M12,12 L16.5,9.5 V7.5"/><EllipseGeometry Center="12,18.5" RadiusX="1.5" RadiusY="1.5"/></GeometryGroup>
  <GeometryGroup x:Key="i_down"><PathGeometry Figures="M7,10 L12,15 L17,10"/></GeometryGroup>
  <!-- アップデート：下向きの矢印と受け皿（PageUpdate.cs） -->
  <GeometryGroup x:Key="i_update"><PathGeometry Figures="M12,4 V15 M7.5,10.5 L12,15 L16.5,10.5 M4.5,15 V18.5 A1.5,1.5 0 0 0 6,20 H18 A1.5,1.5 0 0 0 19.5,18.5 V15"/></GeometryGroup>
  <GeometryGroup x:Key="i_headphones"><PathGeometry Figures="M4.5,15.5 V12.5 A7.5,7.5 0 0 1 19.5,12.5 V15.5 M4.5,14 H8 V20 H6 A1.5,1.5 0 0 1 4.5,18.5 Z M19.5,14 H16 V20 H18 A1.5,1.5 0 0 0 19.5,18.5 Z"/></GeometryGroup>
  <GeometryGroup x:Key="i_mute"><PathGeometry Figures="M4,9.5 H7.5 L12,6 V18 L7.5,14.5 H4 Z M15.5,9.5 L20,14 M20,9.5 L15.5,14"/></GeometryGroup>
  <!-- カメラの操作のまとまり（PageCamCtl.cs） -->
  <GeometryGroup x:Key="i_rotate"><PathGeometry Figures="M19,12 A7,7 0 1 1 16.95,7.05 M13.6,7.2 H17.2 V3.6"/></GeometryGroup>
  <GeometryGroup x:Key="i_zoom">
    <EllipseGeometry Center="10.5,10.5" RadiusX="6" RadiusY="6"/>
    <PathGeometry Figures="M15,15 L20,20 M8,10.5 H13 M10.5,8 V13"/>
  </GeometryGroup>
  <GeometryGroup x:Key="i_focus">
    <PathGeometry Figures="M4,8.5 V5.5 A1.5,1.5 0 0 1 5.5,4 H8.5 M15.5,4 H18.5 A1.5,1.5 0 0 1 20,5.5 V8.5 M20,15.5 V18.5 A1.5,1.5 0 0 1 18.5,20 H15.5 M8.5,20 H5.5 A1.5,1.5 0 0 1 4,18.5 V15.5"/>
    <EllipseGeometry Center="12,12" RadiusX="3" RadiusY="3"/>
  </GeometryGroup>
  <GeometryGroup x:Key="i_sun">
    <EllipseGeometry Center="12,12" RadiusX="3.5" RadiusY="3.5"/>
    <PathGeometry Figures="M12,3 V5 M12,19 V21 M3,12 H5 M19,12 H21 M5.6,5.6 L7,7 M17,17 L18.4,18.4 M5.6,18.4 L7,17 M17,7 L18.4,5.6"/>
  </GeometryGroup>
  <GeometryGroup x:Key="i_drop"><PathGeometry Figures="M12,3.8 C10,6.5 6,10.6 6,14.2 A6,6 0 0 0 18,14.2 C18,10.6 14,6.5 12,3.8 Z"/></GeometryGroup>
  <GeometryGroup x:Key="i_bulb"><PathGeometry Figures="M9.5,17 H14.5 M10.2,20 H13.8 M9.5,17 C9.5,14.6 6.5,13.4 6.5,9.8 A5.5,5.5 0 0 1 17.5,9.8 C17.5,13.4 14.5,14.6 14.5,17"/></GeometryGroup>
  <GeometryGroup x:Key="i_stab">
    <RectangleGeometry Rect="7.5,6,9,12" RadiusX="1.5" RadiusY="1.5"/>
    <PathGeometry Figures="M4,9 V15 M20,9 V15"/>
  </GeometryGroup>
  <GeometryGroup x:Key="i_person">
    <EllipseGeometry Center="12,8.8" RadiusX="3.3" RadiusY="3.3"/>
    <PathGeometry Figures="M5.5,19.5 C6.3,15.8 8.8,14.2 12,14.2 C15.2,14.2 17.7,15.8 18.5,19.5"/>
  </GeometryGroup>

  <!-- テーマ：丸の右半分を塗る（Tag に線、Content に塗る形） -->
  <GeometryGroup x:Key="i_theme"><EllipseGeometry Center="12,12" RadiusX="8.5" RadiusY="8.5"/></GeometryGroup>
  <PathGeometry x:Key="i_theme_fill" Figures="M12,3.5 A8.5,8.5 0 0 1 12,20.5 Z"/>

  <!-- アイコンを置く箱。Tag に線の形、Content に塗る形（録画の点・テーマの半分だけ） -->
  <Style x:Key="Ico" TargetType="ContentControl">
    <Setter Property="Width" Value="20"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Foreground" Value="{DynamicResource IconInk}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
              <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              <Path Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Fill="{TemplateBinding Foreground}"/>
            </Canvas>
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Ico16" TargetType="ContentControl" BasedOn="{StaticResource Ico}"><Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/></Style>
  <Style x:Key="Ico17" TargetType="ContentControl" BasedOn="{StaticResource Ico}"><Setter Property="Width" Value="17"/><Setter Property="Height" Value="17"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style x:Key="Ico28" TargetType="ContentControl" BasedOn="{StaticResource Ico}"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <!-- 行の左のアイコン（20・右に 16 空ける） -->
  <Style x:Key="RowIco" TargetType="ContentControl" BasedOn="{StaticResource Ico}">
    <Setter Property="Margin" Value="0,0,16,0"/>
    <Setter Property="DockPanel.Dock" Value="Left"/>
  </Style>

  <!-- ===== 文字 ===== -->
  <Style x:Key="H1" TargetType="TextBlock">
    <Setter Property="FontSize" Value="28"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,0,0,14"/>
  </Style>
  <Style x:Key="Sec" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="2,18,0,8"/>
  </Style>
  <Style x:Key="Intro" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="0,-4,0,14"/>
  </Style>
  <Style x:Key="RowTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="RowSub" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
    <Setter Property="Margin" Value="0,2,0,0"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Val" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="16,0,0,0"/>
    <Setter Property="DockPanel.Dock" Value="Right"/>
  </Style>
  <Style x:Key="HeroTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="HeroText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
    <Setter Property="Margin" Value="0,6,0,0"/>
    <Setter Property="LineHeight" Value="22"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Foot" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- ===== カードと行 ===== -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="7"/>
  </Style>
  <!-- 1 行目。2 行目からは RowNext（上に区切りの線） -->
  <Style x:Key="Row" TargetType="Border">
    <Setter Property="MinHeight" Value="58"/>
    <Setter Property="Padding" Value="20,9"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style x:Key="RowNext" TargetType="Border" BasedOn="{StaticResource Row}">
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
  </Style>

  <!-- ===== ボタン ===== -->
  <Style x:Key="Btn" TargetType="Button">
    <Setter Property="Height" Value="32"/>
    <Setter Property="MinWidth" Value="32"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="Background" Value="{DynamicResource BtnBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BtnLine}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"/>
            <Border x:Name="ov" Background="Transparent" CornerRadius="4" Margin="1" IsHitTestVisible="False"/>
            <ContentPresenter x:Name="cp" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ov" Property="Background" Value="{DynamicResource BtnHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ov" Property="Background" Value="{DynamicResource BtnPress}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource FocusLine}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="cp" Property="Opacity" Value="0.4"/>
              <Setter TargetName="b" Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
  </Style>
  <Style x:Key="BtnRow" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Margin" Value="12,0,0,0"/>
    <Setter Property="DockPanel.Dock" Value="Right"/>
  </Style>
  <!-- 文字だけのリンク -->
  <Style x:Key="Link" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <TextBlock x:Name="t" Text="{TemplateBinding Content}" Background="Transparent"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== 左の一覧（アイコンの塗る形は DataContext に。録画の点だけ） ===== -->
  <Style x:Key="Nav" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="b" Height="36" CornerRadius="4" Background="Transparent" Padding="12,0" Margin="0,0,0,3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ContentControl Style="{StaticResource Ico17}" Tag="{TemplateBinding Tag}" Content="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"/>
              <ContentPresenter Margin="14,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource NavHover}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource NavSel}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== 切り替えの組（720p・1080p・4K など） ===== -->
  <Style x:Key="SegBox" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SegBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SegLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="DockPanel.Dock" Value="Right"/>
    <Setter Property="Margin" Value="16,0,0,0"/>
  </Style>
  <Style x:Key="SegItem" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource SegText}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="b" CornerRadius="4" Padding="14,4" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" RecognizesAccessKey="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource SegHover}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource SegSel}"/>
              <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource SegSelLine}"/>
              <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== オン・オフ ===== -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="DockPanel.Dock" Value="Right"/>
    <Setter Property="Margin" Value="16,0,0,0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <TextBlock x:Name="t" Text="{DynamicResource s_off}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Border x:Name="tr" Width="40" Height="20" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource SwLine}" Background="{DynamicResource SwTrack}">
              <Ellipse x:Name="k" Width="10" Height="10" Fill="{DynamicResource SwKnob}" HorizontalAlignment="Left" Margin="4,0,0,0"/>
            </Border>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="k" Property="Width" Value="12"/>
              <Setter TargetName="k" Property="Height" Value="12"/>
              <Setter TargetName="tr" Property="Background" Value="{DynamicResource SwHover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="t" Property="Text" Value="{DynamicResource s_on}"/>
              <Setter TargetName="tr" Property="Background" Value="{DynamicResource Accent}"/>
              <Setter TargetName="tr" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              <Setter TargetName="k" Property="Fill" Value="{DynamicResource AccentText}"/>
              <Setter TargetName="k" Property="Width" Value="12"/>
              <Setter TargetName="k" Property="Height" Value="12"/>
              <Setter TargetName="k" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="k" Property="Margin" Value="0,0,3,0"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== 選ぶ（ComboBox） ===== -->
  <Style x:Key="SelectItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="b" CornerRadius="4" Padding="10,6" Background="Transparent">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource SelHover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource SelSel}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Select" TargetType="ComboBox">
    <Setter Property="Width" Value="196"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="DockPanel.Dock" Value="Right"/>
    <Setter Property="Margin" Value="16,0,0,0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource SelectItem}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Grid>
                    <Border Background="{DynamicResource BtnBg}" BorderBrush="{DynamicResource BtnLine}" BorderThickness="1" CornerRadius="4"/>
                    <Border x:Name="ov" Background="Transparent" CornerRadius="4" Margin="1"/>
                    <ContentControl Style="{StaticResource Ico16}" Tag="{StaticResource i_down}" HorizontalAlignment="Right" Margin="0,0,10,0" Foreground="{DynamicResource Ink}"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ov" Property="Background" Value="{DynamicResource BtnHover}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter IsHitTestVisible="False" Margin="12,0,34,0" VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
              <Border Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource PopupLine}" BorderThickness="1" CornerRadius="7" Padding="4" Margin="0,4,0,0"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="340">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <!-- 押せないときは、スイッチと同じく薄くする -->
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== 入力欄 ===== -->
  <Style x:Key="Field" TargetType="TextBox">
    <Setter Property="Height" Value="32"/>
    <Setter Property="Width" Value="196"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Selection}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="DockPanel.Dock" Value="Right"/>
    <Setter Property="Margin" Value="16,0,0,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="b" Background="{DynamicResource FieldBg}" BorderBrush="{DynamicResource FieldLine}" BorderThickness="1" CornerRadius="4">
            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" VerticalAlignment="Center" Focusable="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource FieldFocusLine}"/><Setter TargetName="b" Property="Background" Value="{DynamicResource FieldFocusBg}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== つまみ（画質） ===== -->
  <Style x:Key="SliderPart" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Grid Background="Transparent"><Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/></Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Width="20" Height="20">
            <Ellipse Fill="{DynamicResource ThumbBg}" Stroke="{DynamicResource ThumbLine}" StrokeThickness="1"/>
            <Ellipse x:Name="dot" Width="10" Height="10" Fill="{DynamicResource Accent}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="dot" Property="Width" Value="12"/><Setter TargetName="dot" Property="Height" Value="12"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Slider" TargetType="Slider">
    <Setter Property="Width" Value="168"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="IsSnapToTickEnabled" Value="True"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="TickFrequency" Value="1"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Height="22">
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderPart}" Background="{DynamicResource Accent}" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderPart}" Background="{DynamicResource SliderRest}" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
              <Track.Thumb><Thumb Style="{StaticResource SliderThumb}"/></Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== 細いスクロールバー（アプリ全体） ===== -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="12"/>
    <Setter Property="MinWidth" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="t" Width="4" CornerRadius="2" Background="{DynamicResource ScrollThumb}" HorizontalAlignment="Center"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Width" Value="6"/><Setter TargetName="t" Property="Background" Value="{DynamicResource ScrollThumbHover}"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
  </Style>
</ResourceDictionary>
