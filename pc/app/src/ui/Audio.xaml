<!-- マイクとスピーカー：ipaudio -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <TextBlock Style="{StaticResource H1}" Text="{DynamicResource s_nav_audio}"/>

  <Border Style="{StaticResource Card}" Padding="20,16">
    <DockPanel>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
        <Button x:Name="AudioStartBtn" Style="{StaticResource BtnPrimary}"/>
      </StackPanel>
      <StackPanel>
        <TextBlock x:Name="AudioState" Style="{StaticResource HeroTitle}"/>
        <TextBlock x:Name="AudioDetail" Style="{StaticResource HeroText}"/>
      </StackPanel>
    </DockPanel>
  </Border>

  <TextBlock Style="{StaticResource Sec}" Text="{DynamicResource s_audio_spk}"/>
  <Border Style="{StaticResource Card}">
    <StackPanel>
      <Border Style="{StaticResource Row}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_speaker}"/>
          <CheckBox x:Name="AudioSpk" Style="{StaticResource Switch}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_audio_spk_title}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_audio_spk_sub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_pc}"/>
          <ComboBox x:Name="AudioSpkDev" Style="{StaticResource Select}" Width="260"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_audio_spk_dev}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_audio_spk_dev_sub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_mute}"/>
          <CheckBox x:Name="AudioMutePc" Style="{StaticResource Switch}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_audio_mute_pc}"/>
            <TextBlock x:Name="AudioMutePcSub" Style="{StaticResource RowSub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_fps}"/>
          <Border Style="{StaticResource SegBox}">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="AudioDelay20" GroupName="adelay" Style="{StaticResource SegItem}" Content="{DynamicResource s_delay_short}"/>
              <RadioButton x:Name="AudioDelay40" GroupName="adelay" Style="{StaticResource SegItem}" Content="{DynamicResource s_delay_std}"/>
              <RadioButton x:Name="AudioDelay80" GroupName="adelay" Style="{StaticResource SegItem}" Content="{DynamicResource s_delay_long}"/>
            </StackPanel>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_audio_delay}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_audio_delay_sub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
  </Border>

  <TextBlock Style="{StaticResource Sec}" Text="{DynamicResource s_audio_mic}"/>
  <Border Style="{StaticResource Card}">
    <StackPanel>
      <Border Style="{StaticResource Row}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_mic}"/>
          <CheckBox x:Name="AudioMic" Style="{StaticResource Switch}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_audio_mic_title}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_audio_mic_sub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_pc}"/>
          <ComboBox x:Name="AudioMicDev" Style="{StaticResource Select}" Width="260"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_audio_mic_dev}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_audio_mic_dev_sub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_mic}"/>
          <CheckBox x:Name="AudioVoice" Style="{StaticResource Switch}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_audio_voice}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_audio_voice_sub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_headphones}"/>
          <CheckBox x:Name="AudioMon" Style="{StaticResource Switch}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_audio_mon}"/>
            <TextBlock x:Name="AudioMonSub" Style="{StaticResource RowSub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_pc}"/>
          <ComboBox x:Name="AudioMonDev" Style="{StaticResource Select}" Width="260"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_audio_mon_dev}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_audio_mon_dev_sub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_speaker}"/>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="AudioMonVolText" Foreground="{DynamicResource Sub}" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="38" TextAlignment="Right"/>
            <Slider x:Name="AudioMonVol" Style="{StaticResource Slider}" Minimum="5" Maximum="100" TickFrequency="5"/>
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_audio_mon_vol}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_audio_mon_vol_sub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
  </Border>
</StackPanel>
