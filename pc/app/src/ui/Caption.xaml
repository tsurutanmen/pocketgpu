<!-- 字幕：livecap -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <TextBlock Style="{StaticResource H1}" Text="{DynamicResource s_nav_caption}"/>

  <Border Style="{StaticResource Card}" Padding="20,16">
    <DockPanel>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
        <Button x:Name="CapStartBtn" Style="{StaticResource BtnPrimary}"/>
      </StackPanel>
      <StackPanel>
        <TextBlock x:Name="CapState" Style="{StaticResource HeroTitle}"/>
        <TextBlock x:Name="CapDetail" Style="{StaticResource HeroText}"/>
        <TextBlock x:Name="CapLines" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="22" Visibility="Collapsed"/>
      </StackPanel>
    </DockPanel>
  </Border>

  <TextBlock Style="{StaticResource Sec}" Text="{DynamicResource s_cap_voice}"/>
  <Border Style="{StaticResource Card}">
    <StackPanel>
      <Border Style="{StaticResource Row}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_speaker}"/>
          <ComboBox x:Name="CapSource" Style="{StaticResource Select}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_cap_source}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_cap_source_sub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_globe}"/>
          <ComboBox x:Name="CapLang" Style="{StaticResource Select}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_cap_lang}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_cap_lang_sub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_translate}"/>
          <ComboBox x:Name="CapTranslate" Style="{StaticResource Select}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_cap_translate}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_cap_translate_sub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_check}"/>
          <CheckBox x:Name="CapAccurate" Style="{StaticResource Switch}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_cap_accurate}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_cap_accurate_sub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
  </Border>

  <TextBlock Style="{StaticResource Sec}" Text="{DynamicResource s_cap_out}"/>
  <Border Style="{StaticResource Card}">
    <StackPanel>
      <Border Style="{StaticResource Row}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_window}"/>
          <CheckBox x:Name="CapWindow" Style="{StaticResource Switch}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_cap_window}"/>
            <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource s_cap_window_sub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_file}"/>
          <CheckBox x:Name="CapObs" Style="{StaticResource Switch}"/>
          <Button x:Name="CapObsOpen" Style="{StaticResource BtnRow}" Margin="16,0,0,0" Content="{DynamicResource s_open_folder}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_cap_obs}"/>
            <TextBlock x:Name="CapObsSub" Style="{StaticResource RowSub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource RowNext}">
        <DockPanel>
          <ContentControl Style="{StaticResource RowIco}" Tag="{StaticResource i_folder}"/>
          <CheckBox x:Name="CapMinutes" Style="{StaticResource Switch}"/>
          <Button x:Name="CapMinutesOpen" Style="{StaticResource BtnRow}" Margin="16,0,0,0" Content="{DynamicResource s_open_folder}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource s_cap_minutes}"/>
            <TextBlock x:Name="CapMinutesSub" Style="{StaticResource RowSub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
  </Border>
</StackPanel>
