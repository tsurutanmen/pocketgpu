<!-- ウィンドウの中身の外枠：左に iPhone の状態と一覧、右にページ。ページは Pages の中に差し込む。
     この Grid の Resources に、画面の文（L）と色（ThemeLight・ThemeDark）を差し込む（Shell.cs）。色は DynamicResource で引く -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource Bg}" UseLayoutRounding="True" SnapsToDevicePixels="True"
      TextElement.FontFamily="{StaticResource UiFont}" TextElement.FontSize="14" TextElement.Foreground="{DynamicResource Ink}"
      TextOptions.TextFormattingMode="Display">
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="300"/>
    <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>

  <DockPanel Grid.Column="0" Margin="12,6,12,0" LastChildFill="True">
    <Grid DockPanel.Dock="Top" Margin="8,10,8,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="56"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource Avatar}">
        <ContentControl Style="{StaticResource Ico28}" Tag="{StaticResource i_phone}" HorizontalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="DevName" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="iPhone"/>
        <TextBlock x:Name="DevState" FontSize="12.5" Foreground="{DynamicResource Sub}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </Grid>
    <StackPanel x:Name="Nav" DockPanel.Dock="Top">
      <RadioButton x:Name="NavHome" GroupName="nav" Style="{StaticResource Nav}" Tag="{StaticResource i_home}" Content="{DynamicResource s_nav_home}"/>
      <RadioButton x:Name="NavGpu" GroupName="nav" Style="{StaticResource Nav}" Tag="{StaticResource i_gpu}" Content="{DynamicResource s_nav_gpu}"/>
      <RadioButton x:Name="NavCamera" GroupName="nav" Style="{StaticResource Nav}" Tag="{StaticResource i_camera}" Content="{DynamicResource s_nav_camera}"/>
      <RadioButton x:Name="NavAudio" GroupName="nav" Style="{StaticResource Nav}" Tag="{StaticResource i_mic}" Content="{DynamicResource s_nav_audio}"/>
      <RadioButton x:Name="NavCaption" GroupName="nav" Style="{StaticResource Nav}" Tag="{StaticResource i_caption}" Content="{DynamicResource s_nav_caption}"/>
      <RadioButton x:Name="NavRecord" GroupName="nav" Style="{StaticResource Nav}" Tag="{StaticResource i_rec}" DataContext="{StaticResource i_rec_fill}" Content="{DynamicResource s_nav_record}"/>
      <RadioButton x:Name="NavCheck" GroupName="nav" Style="{StaticResource Nav}" Tag="{StaticResource i_check}" Content="{DynamicResource s_nav_check}"/>
      <RadioButton x:Name="NavSettings" GroupName="nav" Style="{StaticResource Nav}" Tag="{StaticResource i_settings}" Content="{DynamicResource s_nav_settings}"/>
    </StackPanel>
    <Grid/>
  </DockPanel>

  <ScrollViewer x:Name="Scroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <Grid x:Name="Pages" Margin="28,14,44,32" MaxWidth="1040" HorizontalAlignment="Stretch"/>
  </ScrollViewer>
</Grid>
