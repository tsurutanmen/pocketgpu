<!-- 明るい色。案 A の色そのまま。ThemeDark.xaml と同じ名前を全部そろえる（片方にだけある名前を作らない）。
     ページと部品からは {DynamicResource 名前} で引く。差し替えると、その場で色が変わる（Theme.cs・Shell.ApplyTheme）。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 地と文字 -->
  <SolidColorBrush x:Key="Bg" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Line" Color="#E5E5E5"/>
  <SolidColorBrush x:Key="Divider" Color="#EDEDED"/>
  <SolidColorBrush x:Key="Ink" Color="#1B1B1B"/>
  <SolidColorBrush x:Key="Sub" Color="#616161"/>
  <SolidColorBrush x:Key="Faint" Color="#8A8A8A"/>
  <SolidColorBrush x:Key="Accent" Color="#005FB8"/>
  <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="IconInk" Color="#3A3A3A"/>
  <SolidColorBrush x:Key="Avatar" Color="#E6E6E6"/>

  <!-- ボタン。上に重ねる色（指を乗せた・押した）は透けた黒 -->
  <SolidColorBrush x:Key="BtnBg" Color="#FDFDFD"/>
  <SolidColorBrush x:Key="BtnLine" Color="#D1D1D1"/>
  <SolidColorBrush x:Key="BtnHover" Color="#09000000"/>
  <SolidColorBrush x:Key="BtnPress" Color="#12000000"/>
  <SolidColorBrush x:Key="FocusLine" Color="#1B1B1B"/>

  <!-- 左の一覧 -->
  <SolidColorBrush x:Key="NavHover" Color="#EBEBEB"/>
  <SolidColorBrush x:Key="NavSel" Color="#E9E9E9"/>

  <!-- 切り替えの組 -->
  <SolidColorBrush x:Key="SegBg" Color="#F0F0F0"/>
  <SolidColorBrush x:Key="SegLine" Color="#E2E2E2"/>
  <SolidColorBrush x:Key="SegText" Color="#3D3D3D"/>
  <SolidColorBrush x:Key="SegHover" Color="#E8E8E8"/>
  <SolidColorBrush x:Key="SegSel" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SegSelLine" Color="#D6D6D6"/>

  <!-- オン・オフ。オンは Accent の地に AccentText のつまみ -->
  <SolidColorBrush x:Key="SwTrack" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SwLine" Color="#8A8A8A"/>
  <SolidColorBrush x:Key="SwKnob" Color="#5A5A5A"/>
  <SolidColorBrush x:Key="SwHover" Color="#F3F3F3"/>

  <!-- 選ぶ（ComboBox）と、開いた一覧 -->
  <SolidColorBrush x:Key="SelHover" Color="#F0F0F0"/>
  <SolidColorBrush x:Key="SelSel" Color="#EAEAEA"/>
  <SolidColorBrush x:Key="PopupBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="PopupLine" Color="#DADADA"/>

  <!-- 入力欄 -->
  <SolidColorBrush x:Key="FieldBg" Color="#FDFDFD"/>
  <SolidColorBrush x:Key="FieldLine" Color="#D1D1D1"/>
  <SolidColorBrush x:Key="FieldFocusBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="FieldFocusLine" Color="#005FB8"/>
  <SolidColorBrush x:Key="Selection" Color="#0078D7"/>

  <!-- つまみ（画質） -->
  <SolidColorBrush x:Key="SliderRest" Color="#8A8A8A"/>
  <SolidColorBrush x:Key="ThumbBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="ThumbLine" Color="#D0D0D0"/>

  <!-- スクロールバー -->
  <SolidColorBrush x:Key="ScrollThumb" Color="#B8B8B8"/>
  <SolidColorBrush x:Key="ScrollThumbHover" Color="#8A8A8A"/>

  <!-- カメラのプレビュー。映像の上の文字は、どちらのモードでも白 -->
  <SolidColorBrush x:Key="PreviewBg" Color="#3B3B3B"/>
  <SolidColorBrush x:Key="PreviewText" Color="#C8FFFFFF"/>
  <SolidColorBrush x:Key="PreviewLabel" Color="#BFFFFFFF"/>

  <!-- iPhone の温度の信号：正常は緑・やや高いは黄・高いと危険は赤（iPhone のアプリの ThermalSignal と同じ 3 色）。危険の文字は赤 -->
  <SolidColorBrush x:Key="SigOk" Color="#13A10E"/>
  <SolidColorBrush x:Key="SigWarm" Color="#E8B000"/>
  <SolidColorBrush x:Key="SigHot" Color="#D13438"/>
  <SolidColorBrush x:Key="SigHotText" Color="#C42B1C"/>
</ResourceDictionary>
